# region model_provider
SILICONFLOW_API_KEY=  # 推荐使用硅基流动免费服务 https://cloud.siliconflow.cn/i/Eo5yTHGJ
WEB_SEARCH_PROVIDER=doubao  # 可选: doubao | tavily
DOUBAO_SEARCH_API_KEY=  # 豆包联网搜索 API Key
TAVILY_API_KEY=  # Tavily 搜索 API Key https://app.tavily.com/

# 身份安全配置：JWT 与 API Key 派生密钥必须分别生成并持久保存，初始化脚本会补齐留空值
YUXI_ENV=development
JWT_SECRET_KEY=
API_KEY_DERIVATION_SECRET=
YUXI_INSTANCE_ID=

# CORS allowed origins for browser clients, comma-separated.
# Development defaults to http://localhost:5173,http://127.0.0.1:5173 when unset.
# Production does not allow cross-origin browser requests unless this is explicitly set.
YUXI_CORS_ORIGINS=

# 并行运行多个 worktree 时配置；单环境无需设置。
# 完整示例见 docs/develop-guides/parallel-worktree-environments.md
# COMPOSE_PROJECT_NAME=yuxi-dev-a
# YUXI_STATE_DIR=../.yuxi/slots/dev-a

# # 其余可选配置
# OPENAI_API_KEY=
# OPENAI_API_BASE=
# ZHIPUAI_API_KEY=
# DASHSCOPE_API_KEY=
# DEEPSEEK_API_KEY=
# ARK_API_KEY=
# MINIMAX_API_KEY=  # MiniMax 大模型 https://platform.minimaxi.com/
# TOGETHER_API_KEY=
# # endregion model_provider

# Production credentials (required by docker-compose.prod.yml)
POSTGRES_PASSWORD=
# 运行时数据库角色 yuxi_app 的登录凭据。它非 superuser、无 BYPASSRLS、不是表 owner，
# 因此 RLS 对它自动生效。storage-migrator 幂等创建该角色（密码只在创建时设置），
# 轮换需要显式执行 ALTER ROLE。生产环境由 docker-compose.prod.yml 强制要求设置。
# POSTGRES_APP_PASSWORD=
# 跨租户发现的专用角色 yuxi_worker_discovery 的登录凭据：只有 SELECT (id) ON tenants。
# storage-migrator 幂等创建该角色（密码只在创建时设置；轮换用 ALTER ROLE）。
#
# ⚠️ 不要把它写进 `.env`：`.env` 会被 **api** 的 env_file 注入，把发现凭据放进 `.env`
# 会把"跨租户发现"泄漏给 API，使"发现能力只属于 worker"这条边界失效。
# 请放在单独的 `.env.discovery`（已被 .gitignore 忽略），它只由 worker 与 storage-migrator 加载：
#   POSTGRES_DISCOVERY_PASSWORD=<口令>
#   POSTGRES_DISCOVERY_URL=postgresql+asyncpg://yuxi_worker_discovery:<口令>@postgres:5432/<POSTGRES_DB>
# 迁移器只读 `POSTGRES_DISCOVERY_PASSWORD`（它用 **owner 连接**创建角色，不需要发现连接串）。
# POSTGRES_DISCOVERY_PASSWORD=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Public images use the frontend same-origin proxy by default.
# MINIO_PUBLIC_URL=/minio

# # region neo4j
# NEO4J_URI=
# NEO4J_USERNAME=
NEO4J_PASSWORD=
# # endregion neo4j

# # Services
# YUXI_SUPER_ADMIN_NAME=
# YUXI_SUPER_ADMIN_PASSWORD=
# # ARQ worker 单任务最长执行时间（秒），默认 3600，长耗时任务需调大
# YUXI_JOB_TIMEOUT_SECONDS=3600
# WORKER_HEALTH_INTERVAL_SECONDS=5  # 必须大于 0 且不超过 10；过长会破坏 worker 故障探测
# READINESS_PROBE_TIMEOUT_SECONDS=2
# READINESS_CACHE_TTL_SECONDS=1

# # URL Whitelist (comma-separated domains/IPs, empty to disable URL parsing)
# YUXI_URL_WHITELIST=github.com,docs.example.com,gitlab.example.com,127.0.0.1

# # MinerU
# MINERU_API_KEY=

# # PaddleOCR API
# PADDLEOCR_API_TOKEN=
# PADDLEOCR_API_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs

# Sandbox (deerFlow-style provisioner)
# SANDBOX_PROVIDER=provisioner
# SANDBOX_PROVISIONER_URL=http://sandbox-provisioner:8002
# 必填，至少 32 个字符；可使用 `openssl rand -hex 32` 生成
SANDBOX_PROVISIONER_TOKEN=
# SANDBOX_VIRTUAL_PATH_PREFIX=/home/gem/user-data
# SANDBOX_EXEC_TIMEOUT_SECONDS=180
# SANDBOX_MAX_OUTPUT_BYTES=262144
# SANDBOX_KEEPALIVE_INTERVAL_SECONDS=30
# SANDBOX_IDLE_TIMEOUT_SECONDS=120
# SANDBOX_IDLE_CHECK_INTERVAL_SECONDS=10
# # sandbox-provisioner backend: docker | kubernetes | memory（仅测试）
# SANDBOX_PROVISIONER_BACKEND=docker

# sandbox-provisioner 通用配置
# SANDBOX_IMAGE=enterprise-public-cn-beijing.cr.volces.com/vefaas-public/all-in-one-sandbox:1.11.0
# Sandbox 运行规格：core（默认，仅 Shell/Python/File）| browser | full
# SANDBOX_RUNTIME_PROFILE=core
# SANDBOX_CONTAINER_PORT=8080
# SANDBOX_HEALTH_TIMEOUT_SECONDS=300
# worker/API 等待 Sandbox 删除响应的上限
# SANDBOX_PROVISIONER_DELETE_TIMEOUT_SECONDS=120
# 不同 Sandbox 同时执行 Docker stop/remove 的最大数量
# SANDBOX_DELETE_CONCURRENCY=32
# Docker stop 发出 SIGTERM 后等待强制终止的秒数
# SANDBOX_CONTAINER_STOP_TIMEOUT_SECONDS=2
# 单个沙盒容器资源上限，仅 Docker backend 生效；非法值在 provisioner 启动时显式失败
# SANDBOX_MEM_LIMIT=2g  # 只接受纯字节数或整数加 k/m/g 后缀，不是完整 Docker 内存格式
# SANDBOX_CPUS=2
# SANDBOX_PIDS_LIMIT=512
# MEMORY_SANDBOX_URL_TEMPLATE=http://agent-sandbox:8000
# SANDBOX_HTTP_PROXY=http://host.docker.internal:7897
# SANDBOX_HTTPS_PROXY=http://host.docker.internal:7897

# Agent 并发容量（默认按单 worker、100 个同时运行的 AgentRun 配置）
# ARQ_MAX_JOBS=140
# Redis 值是对应进程内每个客户端池的连接上限；进程可按需创建多个池，且不会预先建满。
# API_REDIS_MAX_CONNECTIONS=256
# WORKER_REDIS_MAX_CONNECTIONS=256
# API_POSTGRES_POOL_SIZE=120
# API_POSTGRES_MAX_OVERFLOW=40
# API_POSTGRES_POOL_TIMEOUT_SECONDS=30
# API_LANGGRAPH_POSTGRES_POOL_SIZE=10
# API_LANGGRAPH_POSTGRES_POOL_TIMEOUT_SECONDS=30
# WORKER_POSTGRES_POOL_SIZE=120
# WORKER_POSTGRES_MAX_OVERFLOW=40
# WORKER_POSTGRES_POOL_TIMEOUT_SECONDS=30
# WORKER_LANGGRAPH_POSTGRES_POOL_SIZE=120
# WORKER_LANGGRAPH_POSTGRES_POOL_TIMEOUT_SECONDS=30
# POSTGRES_MAX_CONNECTIONS=600

# Docker backend 专用 (used when SANDBOX_PROVISIONER_BACKEND=docker)
# 动态沙箱专用网络，不要与 app-network 使用同一个名称；默认跟随 COMPOSE_PROJECT_NAME。
# SANDBOX_DOCKER_NETWORK_PREFIX=yuxi-dev-a-sandbox
# 默认从专用地址池为每个 Sandbox 分配独立子网；部署前确认不与宿主机、VPN 和 Docker 网络重叠。
# SANDBOX_DOCKER_ADDRESS_POOL=10.253.240.0/20
# SANDBOX_DOCKER_SUBNET_PREFIX=28
# SANDBOX_DOCKER_USER_DATA_HOST_PATH=
# SANDBOX_DOCKER_SANDBOX_PREFIX=yuxi-dev-a-sandbox

# Kubernetes backend 专用 (used when SANDBOX_PROVISIONER_BACKEND=kubernetes)
# SANDBOX_K8S_NAMESPACE=yuxi-know
# SANDBOX_NODE_HOST=host.docker.internal
# KUBECONFIG_PATH=/root/.kube/config
# USER_DATA_PVC=yuxi-user-data  # UserWorkspace（含 projects），存储类必须支持 RWX
# SKILLS_PVC=yuxi-skills        # 用户授权 Skill 只读投影

# Milvus 容器 CPU 上界（重建容器后生效；让镜像内置 maxprocs 按 cgroup quota 收敛 GOMAXPROCS）
# 内存随知识库数据量线性增长，故意不设上限：硬上界只会在数据合法增长时
# 把容器推入 OOM→重启→重加载→再 OOM 的循环，监控告警比 kill 更合适
# YUXI_MILVUS_CPUS=2

# 原业务 MySQL 问数（可选；只在 worker 中执行，生产环境必须使用只读账号）
# YUXI_BUSINESS_DB_HOST=host.docker.internal
# YUXI_BUSINESS_DB_PORT=3306
# YUXI_BUSINESS_DB_USER=readonly_user
# YUXI_BUSINESS_DB_PASSWORD=
# YUXI_BUSINESS_DB_NAME=business_database
# YUXI_BUSINESS_DB_QUERY_TIMEOUT_MS=10000
# 单次查询行数上限。只能收紧、不能扩权：实际生效值 = min(代码上限 200, YAML/RBAC 上限, 本值)。
# YUXI_BUSINESS_DB_MAX_ROWS=200
# uid 到业务身份的服务端映射：business_user_id 必填；tenant_id 可省略（由业务库推导，
# 用户归属多个租户时必须显式指定）。**员工编号不在此声明**，由解析器按当前租户推导。
# 禁止让前端或模型填写 business_user_id / tenant_id / staff_id。
# allowed_tables、allowed_columns 是可选收紧项，只能缩小授权、不能扩权；清洗后为空按配置错误拒绝。
# 已废弃且会被拒绝的键：staff_id、allow_all_projects、allow_project_member_rows
# （查看其他项目成员必须由 RBAC/YAML 资源授权表达，不能用环境变量取消 STAFF_ID 行范围）。
# YUXI_BUSINESS_DB_IDENTITIES_JSON={"yuxi-user-uid":{"business_user_id":17,"tenant_id":1}}
